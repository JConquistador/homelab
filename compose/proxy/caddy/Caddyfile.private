:8080 {
	@prowlarr path /prowlarr /prowlarr/*

	handle @prowlarr {
		reverse_proxy prowlarr:9696
	}

	@sonarr path /sonarr /sonarr/*

	handle @sonarr {
		reverse_proxy sonarr:8989
	}

	@radarr path /radarr /radarr/*

	handle @radarr {
		reverse_proxy radarr:7878
	}

	@lidarr path /lidarr /lidarr/*

	handle @lidarr {
		reverse_proxy lidarr:8686
	}

	@bazarr path /bazarr /bazarr/*

	handle @bazarr {
		reverse_proxy bazarr:6767
	}

	@sabnzbd path /sabnzbd /sabnzbd/*

	handle @sabnzbd {
		reverse_proxy sabnzbd:8080
	}

	@qbittorrent_no_slash path /qbittorrent
	redir @qbittorrent_no_slash /qbittorrent/ permanent

	@qbittorrent path /qbittorrent /qbittorrent/*

	handle @qbittorrent {
		uri strip_prefix /qbittorrent
		reverse_proxy gluetun:8082 {
			header_up Host {upstream_hostport}
		}
	}

	handle {
		reverse_proxy homepage:3000
	}
}

:8081 {
	reverse_proxy uptime-kuma:3001
}
