# Infrastructure Stack configuration - Copy this file to .env and customize values as needed

# User/group IDs
PUID=1001
PGID=1001

# Timezone
TZ=America/New_York

# Host storage root
# Windows development:
# HOMELAB_ROOT=E:/homelab
#
# Ubuntu / WSL:
# HOMELAB_ROOT=/mnt/e/homelab
#
# Linux production:
# HOMELAB_ROOT=/srv/homelab
HOMELAB_ROOT=/srv/homelab

# Cloudflare API token - used to keep dynamic DNS up to date
CLOUDFLARE_API_TOKEN=changeme