# Homelab media stack configuration
# Copy this file to .env and customize values as needed

# Time zone
TZ=America/New_York

# Container user/group IDs
PUID=1000
PGID=1000

# Host storage root
# Windows PowerShell:
# HOMELAB_ROOT=E:/homelab
#
# Ubuntu / WSL:
# HOMELAB_ROOT=/mnt/e/homelab
#
# Linux production:
# HOMELAB_ROOT=/srv/homelab

HOMELAB_ROOT=E:/homelab

# Mullvad VPN
# WireGuard credentials generated from Mullvad account configuration
VPN_SERVICE_PROVIDER=mullvad
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=changeme
WIREGUARD_ADDRESSES=changeme

# Mullvad server country selection
# Example: USA
SERVER_COUNTRIES=