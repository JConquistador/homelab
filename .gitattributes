# Normalize text files to LF
* text=auto eol=lf

# Explicitly treat common files as text
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.env text eol=lf

# Docker
Dockerfile text eol=lf
Dockerfile.* text eol=lf
*.Dockerfile text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Ignore binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary